# Postgres (Railway reference: ${{Postgres.DATABASE_URL}})
DATABASE_URL=

# Public base URL, no trailing slash
APP_URL=https://indieinterviewer.com

# Random 32+ char string used to sign session cookies
SESSION_SECRET=

# Comma-separated list of admin emails allowed to sign in
ADMIN_EMAILS=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-5.5

# Resend (sending-only key restricted to send.indieinterviewer.com)
RESEND_API_KEY=
MAIL_FROM=Indie Hustle <interviews@send.indieinterviewer.com>
RESEND_WEBHOOK_SECRET=

# Railway bucket (S3 compatible)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
